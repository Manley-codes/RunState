// Set RUNSTATE_FIELD_TOOLS=YES for the personal field build and its simulator tests.
RUNSTATE_FIELD_TOOLS = NO
RUNSTATE_FIELD_FLAG_YES = RUNSTATE_FIELD_TOOLS
RUNSTATE_FIELD_FLAG = $(RUNSTATE_FIELD_FLAG_$(RUNSTATE_FIELD_TOOLS))
RUNSTATE_FIELD_EXCLUSIONS_NO = field-finish-*.mp3 music-finish-response.json snippet_close.wav
EXCLUDED_SOURCE_FILE_NAMES = $(inherited) $(RUNSTATE_FIELD_EXCLUSIONS_$(RUNSTATE_FIELD_TOOLS))
